<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/pricing.css">
    <title>Pricing · Snippy</title>
</head>

<body>

    <%- include('partials/navbar') %>

    <div class="page-wrap">
        <div class="hero">
            <h1>Choose a pricing plan that grows with you</h1>
            <p>Pick a plan that fits how many links you shorten. Upgrade or cancel anytime.</p>
        </div>

        <div class="plans">

            <div class="plan-card">
                <h2>Free</h2>
                <div class="price">₹0<span>/mo</span></div>
                <p class="plan-desc">Great for personal use and trying things out.</p>
                <ul>
                    <li>✔ 50 short links / month</li>
                    <li>✔ Basic click analytics</li>
                    <li>✔ Standard support</li>
                </ul>
                <a href="/signup" class="plan-btn">Get Started</a>
            </div>

            <div class="plan-card featured">
                <div class="badge">Most Popular</div>
                <h2>Pro</h2>
                <div class="price">₹299<span>/mo</span></div>
                <p class="plan-desc">For creators and small teams who need more.</p>
                <ul>
                    <li>✔ Unlimited short links</li>
                    <li>✔ Advanced click analytics</li>
                    <li>✔ Custom short IDs</li>
                    <li>✔ Priority support</li>
                </ul>
                <a href="/signup" class="plan-btn plan-btn-primary">Get Started</a>
            </div>

            <div class="plan-card">
                <h2>Business</h2>
                <div class="price">₹999<span>/mo</span></div>
                <p class="plan-desc">For companies that need scale and control.</p>
                <ul>
                    <li>✔ Everything in Pro</li>
                    <li>✔ Team member accounts</li>
                    <li>✔ API access</li>
                    <li>✔ Dedicated support</li>
                </ul>
                <a href="/signup" class="plan-btn">Get Started</a>
            </div>

        </div>
    </div>

</body>

</html>
